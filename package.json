{
  "name": "videoeditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts HelloWorld out/remotion.mp4",
    "hyperframes": "hyperframes",
    "hyperframes:preview": "cd hyperframes/beispiel && hyperframes preview",
    "hyperframes:render": "cd hyperframes/beispiel && hyperframes render -o renders/beispiel.mp4",
    "short:preview": "cd hyperframes/short-andere-denken && hyperframes preview",
    "short:render": "cd hyperframes/short-andere-denken && hyperframes render -o renders/niemand-denkt-an-dich.mp4"
  },
  "dependencies": {
    "@hyperframes/core": "^0.9.8",
    "@remotion/cli": "^4.0.540",
    "hyperframes": "^0.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
